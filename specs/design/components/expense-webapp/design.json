{
  "name": "expense-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "expense-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9
  ],
  "description": "Single-page app for the household to sign in, log daily expenses, browse and edit the shared expense list, manage categories and their limits, and view daily/weekly/monthly and per-category totals with limit-status indicators. Calls expense-api for all data; holds no persistent state of its own.",
  "dependencies": [
    {
      "kind": "component",
      "name": "expense-api",
      "wiring": {
        "endpoint": {
          "component": "testing9231-expense-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EXPENSE_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "testing9231-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
